# ===================== PARABOLOID MOUNTAIN RANGE (miniRT .rt) ==================
# Kamera / Licht / Ambient
A    0.18                 255,255,255
C    0,3,-25              0,0,1                 70
L   -30,40,-10            1.2                   255,240,210   
L     20,8,-5             0.15                  180,200,255   

# Sky & Shading (falls du so etwas nutzt)
SF   d_asc

# Bodenebene (Wiese/Erde)
pl   0,-2,0               0,1,0                 60,80,45      spc:0.2,10 mir:0.00

# --------------------- BERG: Hauptgipfel (Mitte) ------------------------------
# Paraboloid öffnet entlang +Y (orientation 0,1,0). 'position' ist der Scheitel.
# Basis (Fels)
pb    0.0,-2.0,42.0       0.0,1.0,0.0           0.42   28.0   95,85,78    spc:0.25,28 mir:0.01
# Schneekappe (oberste 7 Einheiten): gleicher p, Vertex nach oben verschoben
pb    0.0,19.0,42.0       0.0,1.0,0.0           0.42    7.0  245,245,245  spc:0.35,60 mir:0.00

# --------------------- BERG: Links (massiv) -----------------------------------
pb  -12.0,-2.0,52.0       0.0,1.0,0.0           0.55   24.0  88,82,76      spc:0.22,25 mir:0.00
pb  -12.0,17.0,52.0       0.0,1.0,0.0           0.55    7.0  245,245,245   spc:0.34,55 mir:0.00

# kleine Nebenkuppe am linken Massiv (etwas steiler = kleineres p)
