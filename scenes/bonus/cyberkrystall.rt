# ==== CYBER-KRISTALL TEMPEL (miniRT .rt) ====================================
A   0.18                        255,255,255

# Kamera: Blick auf schwebenden Kristall über Energiekreis
C   0,6,25                     0,-0.2,-1              70

# Licht: Hauptlicht + Atmosphäre + Unterboden-Glow
L   0,15,5                     1.2                    255,240,230
L   0,-1,0                     0.6                    120,180,255
L   -15,10,10                  0.3                    255,200,255

# =====================================================================
# BODEN - ENERGIEKREIS, SPIEGELND, MIT MYSTISCHEM GLOW
# =====================================================================
pl  0,-2,0                     0,1,0                  20,25,40        spc:0.4,20 mir:0.3

# Glowing Energy Ring (aus Sphären)
sp  6,-1.9,0                   0.6                    0,180,255       spc:0.1,10 mir:0.2
sp -6,-1.9,0                   0.6                    0,180,255       spc:0.1,10 mir:0.2
sp  0,-1.9,6                   0.6                    0,180,255       spc:0.1,10 mir:0.2
sp  0,-1.9,-6                  0.6                    0,180,255       spc:0.1,10 mir:0.2
sp  4.2,-1.9,4.2               0.6                    0,180,255       spc:0.1,10 mir:0.2
sp -4.2,-1.9,4.2               0.6                    0,180,255       spc:0.1,10 mir:0.2
sp  4.2,-1.9,-4.2              0.6                    0,180,255       spc:0.1,10 mir:0.2
sp -4.2,-1.9,-4.2              0.6                    0,180,255       spc:0.1,10 mir:0.2

# =====================================================================
# ZENTRALER KRISTALL - SCHWEBEND, TRANSPARENT & SPIEGELND
# =====================================================================
sp   0,4,0                     3.5                    200,200,255     spc:0.5,40 mir:0.4
tr   -1,4,0   1,4,0    0,6,1.5                      230,230,255     spc:0.5,30 mir:0.4
tr   -1,4,0   0,6,-1.5  1,4,0                       230,230,255     spc:0.5,30 mir:0.4
tr    0,6,1.5  0,6,-1.5  1,4,0                      230,230,255     spc:0.5,30 mir:0.4
tr    0,6,1.5  0,6,-1.5 -1,4,0                      230,230,255     spc:0.5,30 mir:0.4

# =====================================================================
# SCHWEBENDE TEMPEL-PLATTFORMEN
# =====================================================================
cy   7,1,7      0,1,0     2.5   0.4       100,100,100     spc:0.2,15 mir:0.05
cy  -7,1,7      0,1,0     2.5   0.4       100,100,100     spc:0.2,15 mir:0.05
cy   7,1,-7     0,1,0     2.5   0.4       100,100,100     spc:0.2,15 mir:0.05
cy  -7,1,-7     0,1,0     2.5   0.4       100,100,100     spc:0.2,15 mir:0.05

# Plattformkanten - Dreiecksstreifen
tr   5,1,7  7,1,9  9,1,7                          90,90,100      spc:0.1,10 mir:0
tr  -5,1,7 -7,1,9 -9,1,7                          90,90,100      spc:0.1,10 mir:0
tr   5,1,-7 7,1,-9 9,1,-7                         90,90,100      spc:0.1,10 mir:0
tr  -5,1,-7 -7,1,-9 -9,1,-7                       90,90,100      spc:0.1,10 mir:0

# =====================================================================
# SCHWEBENDE LICHTKRISTALLE (wie magische Lampen)
# =====================================================================
sp   3,5,0                     1.0                    180,220,255     spc:0.2,20 mir:0.1
sp  -3,5,0                     1.0                    180,220,255     spc:0.2,20 mir:0.1
sp   0,5,3                     1.0                    180,220,255     spc:0.2,20 mir:0.1
sp   0,5,-3                    1.0                    180,220,255     spc:0.2,20 mir:0.1

# =====================================================================
# DREHENDE DREIECKE - ZIERSTRUKTUREN UM DEN KRISTALL
# =====================================================================
tr   2,4.5,0   2.5,5,0.5   2.5,4.5,1              150,150,255     spc:0.3,20 mir:0.2
tr  -2,4.5,0  -2.5,5,0.5  -2.5,4.5,1              150,150,255     spc:0.3,20 mir:0.2
tr   0,4.5,2   0.5,5,2.5   0,4.5,3                150,150,255     spc:0.3,20 mir:0.2
tr   0,4.5,-2  0.5,5,-2.5  0,4.5,-3               150,150,255     spc:0.3,20 mir:0.2

# =====================================================================
# NEBEL & ENERGIEPARTIKEL
# =====================================================================
sp   1,2.5,0                    0.3                100,200,255       spc:0.1,10 mir:0
sp  -1,2.3,1.2                  0.3                90,190,240        spc:0.1,10 mir:0
sp   0.2,2.1,-1.1               0.2                80,180,255        spc:0.1,10 mir:0
sp   1.5,2.6,-0.8               0.2                100,220,255       spc:0.1,10 mir:0

# Lichtschein von unten
sp   0,-1.8,0                   6.0                30,80,200         spc:0,0 mir:0.2

